# Copy to `.env` (or export the variables) and adjust.
# All of them are optional: without a file the gateway proxied to api.openai.com.

# --- upstream model endpoint (any OpenAI-compatible API) ---
# OpenAI:            https://api.openai.com/v1
# Ollama:            http://127.0.0.1:11434/v1
# LM Studio:         http://127.0.0.1:1234/v1
# vLLM / LiteLLM:    http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# Comma separated; shown in Folo's model picker. Defaults to AI_MODEL.
AI_MODELS=gpt-4o-mini,gpt-4o

# --- optional tuning ---
# AI_TEMPERATURE=0.3
# AI_MAX_OUTPUT_TOKENS=2048
# AI_TRANSLATION_CONCURRENCY=3
# AI_HEADERS={"X-Some-Header":"value"}

# --- long content (never truncated, just split into several calls) ---
# Summaries beyond this many characters are summarized part by part and merged.
# AI_SUMMARY_CHUNK_CHARS=12000
# Translation fields beyond this many characters are translated chunk by chunk per field.
# AI_TRANSLATION_CHUNK_CHARS=8000

# --- chat context budget announced to the client via GET /ai/chat/config ---
# AI_CONTEXT_MAX_ENTRIES=20
# AI_CONTEXT_MAX_CHARS_PER_ENTRY=20000
# AI_CONTEXT_MAX_TOTAL_CHARS=60000

# --- gateway itself ---
HOST=127.0.0.1
PORT=8788
# Recommended when the gateway is reachable from your LAN (e.g. from a phone).
# GATEWAY_TOKEN=change-me
